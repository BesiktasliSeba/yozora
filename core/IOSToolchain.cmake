set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR "$ENV{YOZORA_SLICE}")
set(CMAKE_OSX_ARCHITECTURES "$ENV{YOZORA_SLICE}")
set(CMAKE_OSX_DEPLOYMENT_TARGET "$ENV{YOZORA_SLICE_MIN}")
set(CMAKE_OSX_SYSROOT "$ENV{YOZORA_SLICE_SDK}")
set(CMAKE_MACOSX_BUNDLE FALSE)
set(CMAKE_C_COMPILER "$ENV{YOZORA_CORE_CC}")
set(CMAKE_CXX_COMPILER "$ENV{YOZORA_CORE_CXX}")
set(CMAKE_ASM_COMPILER "$ENV{YOZORA_CORE_CC}")
set(CMAKE_OBJC_COMPILER "$ENV{YOZORA_CORE_CC}")
set(CMAKE_OBJCXX_COMPILER "$ENV{YOZORA_CORE_CXX}")
set(CMAKE_C_COMPILER_TARGET "$ENV{YOZORA_SLICE}-apple-ios$ENV{YOZORA_SLICE_MIN}")
set(CMAKE_CXX_COMPILER_TARGET "${CMAKE_C_COMPILER_TARGET}")
set(CMAKE_ASM_COMPILER_TARGET "${CMAKE_C_COMPILER_TARGET}")
set(CMAKE_OBJC_COMPILER_TARGET "${CMAKE_C_COMPILER_TARGET}")
set(CMAKE_OBJCXX_COMPILER_TARGET "${CMAKE_C_COMPILER_TARGET}")
set(CMAKE_AR "$ENV{YOZORA_CORE_AR}")
set(CMAKE_RANLIB "$ENV{YOZORA_CORE_RANLIB}")
set(CMAKE_LINKER "$ENV{YOZORA_TC}/ld")
# old cctools ld accepts version_min flags, not clang's current platform_version flags
set(CMAKE_C_FLAGS_INIT "-B \"$ENV{YOZORA_TC}\" -mlinker-version=253")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_OSX_SYSROOT};$ENV{YOZORA_SLICE_DEPS}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
