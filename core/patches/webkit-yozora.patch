diff -ruN --no-dereference a/Source/WebCore/PlatformYozora.cmake b/Source/WebCore/PlatformYozora.cmake
--- a/Source/WebCore/PlatformYozora.cmake
+++ b/Source/WebCore/PlatformYozora.cmake
@@ -0,0 +1,96 @@
+include(platform/Curl.cmake)
+include(platform/OpenSSL.cmake)
+include(platform/ImageDecoders.cmake)
+include(platform/Skia.cmake)
+include(platform/Adwaita.cmake)
+
+if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    if (NOT EXISTS "${YOZORA_WEBCORE_ROOT}/SharedMemoryLinux.cpp")
+        message(FATAL_ERROR "yozora: set YOZORA_WEBCORE_ROOT to the maintained WebCore platform sources")
+    endif ()
+    list(APPEND WebCore_SOURCES "${YOZORA_WEBCORE_ROOT}/SharedMemoryLinux.cpp")
+elseif (APPLE)
+    list(APPEND WebCore_SOURCES
+        "${YOZORA_WEBCORE_ROOT}/SharedMemoryDarwin.cpp"
+        "${YOZORA_DARWIN_ROOT}/yozora_memory.c"
+    )
+endif ()
+
+list(APPEND WebCore_UNIFIED_SOURCE_LIST_FILES
+    "SourcesYozora.txt"
+)
+
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+    "${WEBCORE_DIR}/platform/generic"
+    "${WEBCORE_DIR}/platform/unix"
+    "${WEBCORE_DIR}/platform/video-codecs"
+    "${WEBCORE_DIR}/platform/yozora"
+)
+
+if (NOT EXISTS "${YOZORA_WEBCORE_ROOT}/FontManagerYozora.cpp")
+    message(FATAL_ERROR "yozora: set YOZORA_WEBCORE_ROOT to the maintained WebCore platform sources")
+endif ()
+list(APPEND WebCore_SOURCES
+    "${YOZORA_WEBCORE_ROOT}/FontManagerYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/FontCacheYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/AccessibilityObjectYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/AXObjectCacheYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/MIMETypeRegistryYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/PlatformScreenYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/SystemFontDatabaseYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/GraphicsLayerYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/../yozora_render_plan.c"
+    platform/text/Hyphenation.cpp
+    "${YOZORA_WEBCORE_ROOT}/PasteboardYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/EditorYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/WebContentReaderYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/PlatformKeyboardEventYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/NetworkStateNotifierYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/CurlSSLHandleYozora.cpp"
+    "${YOZORA_WEBCORE_ROOT}/YozoraBytecodeCache.cpp"
+    platform/text/LocaleICU.cpp
+)
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES "${YOZORA_WEBCORE_ROOT}")
+
+list(APPEND WebCore_PRIVATE_FRAMEWORK_HEADERS
+    "${YOZORA_WEBCORE_ROOT}/AccessibilityObjectYozora.h"
+)
+
+if (ENABLE_WEBGL)
+    # core/webgl makes the entry points of ANGLE over the OpenGL ES of the system, WebKit takes them for ANGLE::GLES
+    if (NOT YOZORA_WEBGL_ROOT)
+        get_filename_component(YOZORA_WEBGL_ROOT "${YOZORA_WEBCORE_ROOT}/../webgl" ABSOLUTE)
+    endif ()
+    if (NOT EXISTS "${YOZORA_WEBGL_ROOT}/yozora_gles.cpp")
+        message(FATAL_ERROR "yozora: set YOZORA_WEBGL_ROOT to the maintained WebGL sources")
+    endif ()
+    set(YOZORA_ANGLE_DIR "${CMAKE_SOURCE_DIR}/Source/ThirdParty/ANGLE")
+    find_package(Python REQUIRED COMPONENTS Interpreter)
+    add_subdirectory("${YOZORA_WEBGL_ROOT}" "${CMAKE_BINARY_DIR}/yozora-webgl")
+    add_library(ANGLE::GLES ALIAS YozoraGLES)
+    list(APPEND WebCore_SOURCES
+        "${YOZORA_WEBCORE_ROOT}/GraphicsContextGLSkiaYozora.cpp"
+        "${YOZORA_WEBCORE_ROOT}/GraphicsContextGLYozora.cpp")
+endif ()
+
+if (ENABLE_WEB_AUDIO)
+    # Web Audio runs on the FFT of the port, a destination that feeds the sound device, and a reader of wave files with the system decoders on Apple systems
+    list(APPEND WebCore_SOURCES
+        "${YOZORA_WEBCORE_ROOT}/FFTFrameYozora.cpp"
+        "${YOZORA_WEBCORE_ROOT}/AudioDestinationYozora.cpp"
+        "${YOZORA_WEBCORE_ROOT}/AudioFileReaderYozora.cpp"
+        "${YOZORA_WEBCORE_ROOT}/AudioDecodeWave.cpp")
+    if (APPLE)
+        list(APPEND WebCore_SOURCES
+            "${YOZORA_WEBCORE_ROOT}/AudioOutputDarwin.cpp"
+            "${YOZORA_WEBCORE_ROOT}/AudioDecodeDarwin.cpp")
+    else ()
+        list(APPEND WebCore_SOURCES "${YOZORA_WEBCORE_ROOT}/AudioOutputHost.cpp")
+    endif ()
+    # the impulse responses of the HRTF panner are one wave in the WebCore sources, here it becomes an array that AudioFileReaderYozora.cpp includes
+    set(YOZORA_AUDIO_GENERATED "${CMAKE_BINARY_DIR}/yozora-audio")
+    file(READ "${WEBCORE_DIR}/platform/audio/resources/Composite.wav" YOZORA_HRTF_HEX HEX)
+    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," YOZORA_HRTF_ARRAY "${YOZORA_HRTF_HEX}")
+    file(WRITE "${YOZORA_AUDIO_GENERATED}/YozoraHRTFComposite.inc" "${YOZORA_HRTF_ARRAY}\n")
+    list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES "${YOZORA_AUDIO_GENERATED}")
+endif ()
