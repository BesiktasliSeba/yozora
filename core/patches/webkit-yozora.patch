diff -ruN --no-dereference a/Source/cmake/OptionsYozora.cmake b/Source/cmake/OptionsYozora.cmake
--- a/Source/cmake/OptionsYozora.cmake
+++ b/Source/cmake/OptionsYozora.cmake
@@ -0,0 +1,139 @@
+include(GNUInstallDirs)
+include(VersioningUtils)
+
+WEBKIT_OPTION_BEGIN()
+
+SET_PROJECT_VERSION(2 54 1)
+
+find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
+set_property(TARGET ICU::i18n APPEND PROPERTY INTERFACE_LINK_LIBRARIES ICU::uc)
+set_property(TARGET ICU::uc APPEND PROPERTY INTERFACE_LINK_LIBRARIES ICU::data)
+find_package(HarfBuzz 2.7.4 REQUIRED COMPONENTS ICU)
+# static hb-icu imports ICU symbols after the main WebCore archive
+set_property(TARGET HarfBuzz::ICU APPEND PROPERTY INTERFACE_LINK_LIBRARIES HarfBuzz::HarfBuzz ICU::uc)
+find_package(Freetype 2.9.0 REQUIRED)
+# freetype is built with zlib and brotli and opens woff and woff2 itself, so webcore leaves out its own converters
+# and with libpng, which the png strikes of the color emoji font need
+SET_AND_EXPOSE_TO_BUILD(HAVE_WOFF_SUPPORT ON)
+find_library(YOZORA_BROTLIDEC_LIBRARY NAMES libbrotlidec.a brotlidec REQUIRED)
+find_library(YOZORA_BROTLICOMMON_LIBRARY NAMES libbrotlicommon.a brotlicommon REQUIRED)
+find_library(YOZORA_FREETYPE_PNG_LIBRARY NAMES libpng16.a png16 REQUIRED)
+set_property(TARGET Freetype::Freetype APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${YOZORA_BROTLIDEC_LIBRARY}" "${YOZORA_BROTLICOMMON_LIBRARY}" "${YOZORA_FREETYPE_PNG_LIBRARY}")
+find_package(JPEG REQUIRED)
+find_package(PNG REQUIRED)
+find_package(WebP REQUIRED COMPONENTS demux)
+if (WebP_LIBRARY MATCHES "\\.a$")
+    find_library(YOZORA_SHARPYUV_LIBRARY NAMES sharpyuv REQUIRED)
+    set_property(TARGET WebP::libwebp APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${YOZORA_SHARPYUV_LIBRARY}")
+endif ()
+find_package(LibXml2 2.9.13 REQUIRED)
+find_package(SQLite3 REQUIRED)
+find_package(Threads REQUIRED)
+find_package(ZLIB REQUIRED)
+find_package(CURL REQUIRED)
+find_package(LibPSL REQUIRED)
+find_package(OpenSSL 3.0 REQUIRED)
+
+if (NOT TARGET SQLite3::SQLite3) # CMake < 4.3
+    add_library(SQLite3::SQLite3 ALIAS SQLite::SQLite3)
+endif ()
+
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_API_TESTS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_LAYOUT_TESTS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DRAG_SUPPORT PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GAMEPAD PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MINIBROWSER PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SPELLCHECK PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_TOUCH_EVENTS PUBLIC ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBDRIVER PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SPEECH_SYNTHESIS PUBLIC OFF)
+
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_AVIF PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_LCMS PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_JPEGXL PUBLIC ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_WOFF2 PUBLIC OFF)
+
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_CONTENT_EXTENSIONS PRIVATE ON)
+# pages answer prefers-color-scheme: dark when the user picks a dark theme
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DARK_MODE_CSS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GPU_PROCESS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_RECORDER PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_SESSION PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_STREAM PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VIDEO PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_AUDIO PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_CODECS PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_RTC PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBGL PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBGPU PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_XSLT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VARIATION_FONTS PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_REMOTE_INSPECTOR PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SKIA PRIVATE ON)
+
+WEBKIT_OPTION_END()
+
+set(ENABLE_WEBKIT OFF)
+set(ENABLE_WEBKIT_LEGACY OFF)
+set(ENABLE_WEBINSPECTORUI OFF)
+set(ENABLE_TOOLS OFF)
+
+set(CMAKE_C_VISIBILITY_PRESET hidden)
+set(CMAKE_CXX_VISIBILITY_PRESET hidden)
+set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
+if (APPLE)
+    set(bmalloc_LIBRARY_TYPE STATIC)
+    set(WTF_LIBRARY_TYPE STATIC)
+else ()
+    set(bmalloc_LIBRARY_TYPE OBJECT)
+    set(WTF_LIBRARY_TYPE OBJECT)
+endif ()
+set(WebCore_LIBRARY_TYPE STATIC)
+set(JavaScriptCore_LIBRARY_TYPE STATIC)
+
+add_definitions(-DBUILDING_YOZORA__=1)
+
+set(EVENT_LOOP_TYPE Generic)
+set(LOWERCASE_EVENT_LOOP_TYPE generic)
+SET_AND_EXPOSE_TO_BUILD(USE_GENERIC_EVENT_LOOP 1)
+SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP 0)
+
+if (APPLE AND NOT YOZORA_ICU_ROOT)
+    add_definitions(-DU_DISABLE_RENAMING=1)
+elseif (YOZORA_ICU_ROOT)
+    add_definitions(-DU_STATIC_IMPLEMENTATION)
+endif ()
+
+if (YOZORA_DARWIN_ROOT)
+    SET_AND_EXPOSE_TO_BUILD(USE_TIME_ZONE_CHANGE_NOTIFICATIONS 1)
+endif ()
+
+SET_AND_EXPOSE_TO_BUILD(USE_THEME_ADWAITA 1)
+SET_AND_EXPOSE_TO_BUILD(USE_SKIA_GPU OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_CAIRO OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_HARFBUZZ 1)
+SET_AND_EXPOSE_TO_BUILD(USE_TEXTURE_MAPPER OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_COORDINATED_GRAPHICS OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_ANGLE OFF)
+
+set(DERIVED_SOURCES_DIR "${CMAKE_BINARY_DIR}/DerivedSources")
+set(FORWARDING_HEADERS_DIR ${DERIVED_SOURCES_DIR}/ForwardingHeaders)
+
+# libjxl is a static archive that needs highway, the color management library and little-cms behind it, the decoder of WebCore names only the first
+if (USE_JPEGXL)
+    find_package(JPEGXL 0.7.0 REQUIRED)
+    find_library(YOZORA_JXL_CMS_LIBRARY NAMES libjxl_cms.a jxl_cms REQUIRED)
+    find_library(YOZORA_HWY_LIBRARY NAMES libhwy.a hwy REQUIRED)
+    find_library(YOZORA_LCMS_LIBRARY NAMES liblcms2.a lcms2 REQUIRED)
+    find_library(YOZORA_JXL_BROTLIENC_LIBRARY NAMES libbrotlienc.a brotlienc REQUIRED)
+    set_property(TARGET JPEGXL::jxl APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${YOZORA_JXL_CMS_LIBRARY}" "${YOZORA_HWY_LIBRARY}" "${YOZORA_LCMS_LIBRARY}"
+        "${YOZORA_JXL_BROTLIENC_LIBRARY}" "${YOZORA_BROTLIDEC_LIBRARY}" "${YOZORA_BROTLICOMMON_LIBRARY}")
+endif ()
+
+SET_AND_EXPOSE_TO_BUILD(USE_CURL 1)
+SET_AND_EXPOSE_TO_BUILD(USE_OPENSSL 1)
+SET_AND_EXPOSE_TO_BUILD(USE_LIBPSL 1)
+
+if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    SET_AND_EXPOSE_TO_BUILD(USE_UNIX_DOMAIN_SOCKETS 1)
+endif ()
