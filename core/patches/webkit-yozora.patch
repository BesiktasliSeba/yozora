+void SpeculativeJIT::compileMapStorage(Node* node)
+{
+    SpeculateCellOperand map(this, node->child1());
+    JSValueRegsTemporary result(this);
+    auto regs = result.regs();
+    if (node->child1().useKind() == MapObjectUse) {
+        speculateMapObject(node->child1(), map.gpr());
+        loadPtr(Address(map.gpr(), JSMap::offsetOfStorage()), regs.payloadGPR());
+    } else if (node->child1().useKind() == SetObjectUse) {
+        speculateSetObject(node->child1(), map.gpr());
+        loadPtr(Address(map.gpr(), JSSet::offsetOfStorage()), regs.payloadGPR());
+    } else
+        RELEASE_ASSERT_NOT_REACHED();
+
+    // an unallocated table is the empty JSValue, not a cell with a null payload
+    move(TrustedImm32(JSValue::CellTag), regs.tagGPR());
+    auto hasStorage = branchTestPtr(NonZero, regs.payloadGPR());
+    move(TrustedImm32(JSValue::EmptyValueTag), regs.tagGPR());
+    hasStorage.link(this);
+    jsValueResult(regs, node);
+}
