+#if PLATFORM(YOZORA)
+// the frame of a lower subsampling level is a whole image decoded with libjpeg's scaled inverse transform,
+// so the full size pixels are never built and the work shrinks with the output
+IntSize JPEGImageDecoder::frameSizeAtIndex(size_t, SubsamplingLevel level) const
+{
+    auto full = size();
+    if (full.isEmpty() || level <= SubsamplingLevel::Default)
+        return full;
+    int denominator = 1 << static_cast<int>(std::min(level, SubsamplingLevel::Last));
+    return { (full.width() + denominator - 1) / denominator, (full.height() + denominator - 1) / denominator };
+}
+
+PlatformImagePtr JPEGImageDecoder::createFrameImageAtIndex(size_t index, SubsamplingLevel level, const DecodingOptions& options)
+{
+    // a partial file is decoded again at the scaled size each time more of it has arrived: the incremental path
+    // would build the whole frame at full size while the image is still coming in
+    if (!index && level > SubsamplingLevel::Default) {
+        Locker locker { m_lock };
+        if (!failed() && isSizeAvailable()) {
+            if (auto image = createScaledFrameImage(level))
+                return image;
+        }
+    }
+    return ScalableImageDecoder::createFrameImageAtIndex(index, level, options);
+}
+
+namespace {
+
+struct ScaledErrorMgr {
+    decoder_error_mgr base;
+    // the first output row that was made from the end marker libjpeg invents for a cut off file
+    unsigned truncatedRow;
+    bool readingRows;
+};
+
+struct ScaledJPEG {
+    ~ScaledJPEG()
+    {
+        if (created)
+            jpeg_destroy_decompress(&info);
+    }
+    jpeg_decompress_struct info { };
+    ScaledErrorMgr error { };
+    JSAMPARRAY rows { nullptr };
+    unsigned width { 0 };
+    unsigned height { 0 };
+    bool created { false };
+    bool complete { true };
+};
+
+}
+
+// a cut off sequential file ends with a warning while rows are read, a progressive one while the scans are read
+static void scaledEmitMessage(j_common_ptr cinfo, int level)
+{
+    if (level >= 0 || cinfo->err->msg_code != JWRN_JPEG_EOF)
+        return;
+    auto* error = reinterpret_cast<ScaledErrorMgr*>(cinfo->err);
+    if (error->readingRows && !error->truncatedRow)
+        error->truncatedRow = reinterpret_cast<jpeg_decompress_struct*>(cinfo)->output_scanline + 1;
+}
+
+// kept free of objects with destructors: libjpeg leaves through longjmp
+static bool readScaledJPEG(ScaledJPEG& jpeg, std::span<const uint8_t> data, unsigned denominator)
+{
+    auto& info = jpeg.info;
+    info.err = jpeg_std_error(&jpeg.error.base.pub);
+    jpeg.error.base.pub.error_exit = error_exit;
+    jpeg.error.base.pub.emit_message = scaledEmitMessage;
+    if (setjmp(jpeg.error.base.setjmp_buffer))
+        return false;
+    jpeg_create_decompress(&info);
+    jpeg.created = true;
+    jpeg_mem_src(&info, data.data(), data.size());
+    if (jpeg_read_header(&info, TRUE) != JPEG_HEADER_OK)
+        return false;
+    switch (info.jpeg_color_space) {
+    case JCS_GRAYSCALE:
+    case JCS_RGB:
+    case JCS_YCbCr:
+        info.out_color_space = rgbOutputColorSpace();
+        break;
+    case JCS_CMYK:
+    case JCS_YCCK:
+        info.out_color_space = JCS_CMYK;
+        break;
+    default:
+        return false;
+    }
+    info.scale_num = 1;
+    info.scale_denom = denominator;
+    info.dct_method = dctMethod();
+    info.dither_mode = ditherMode();
+    info.do_fancy_upsampling = doFancyUpsampling() ? TRUE : FALSE;
+    info.enable_2pass_quant = FALSE;
+    info.do_block_smoothing = TRUE;
+    info.buffered_image = FALSE;
+    if (!jpeg_start_decompress(&info))
+        return false;
+    jpeg.width = info.output_width;
+    jpeg.height = info.output_height;
+    if (!jpeg.width || !jpeg.height || ImageBackingStore::isOverSize(IntSize(jpeg.width, jpeg.height)))
+        return false;
+    // the image pool is released by jpeg_finish_decompress, the rows are read after it
+    jpeg.rows = (*info.mem->alloc_sarray)(reinterpret_cast<j_common_ptr>(&info), JPOOL_PERMANENT, jpeg.width * info.output_components, jpeg.height);
+    jpeg.error.readingRows = true;
+    while (info.output_scanline < info.output_height) {
+        JSAMPROW row = jpeg.rows[info.output_scanline];
+        if (jpeg_read_scanlines(&info, &row, 1) != 1)
+            return false;
+    }
+    jpeg.complete = !jpeg.error.truncatedRow;
+    return jpeg_finish_decompress(&info);
+}
+
+PlatformImagePtr JPEGImageDecoder::createScaledFrameImage(SubsamplingLevel level)
+{
+    assertIsHeld(m_lock);
+#if USE(LCMS)
+    // the scaled path has no color transform
+    if (m_iccTransform)
+        return nullptr;
+#endif
+    if (!m_data)
+        return nullptr;
+    ScaledJPEG jpeg;
+    if (!readScaledJPEG(jpeg, m_data->span(), 1u << static_cast<int>(std::min(level, SubsamplingLevel::Last))))
+        return nullptr;
+    auto store = ImageBackingStore::create(IntSize(jpeg.width, jpeg.height), m_premultiplyAlpha);
+    if (!store)
+        return nullptr;
+    // the rows near the cut mix real and invented data, one block row of margin at the scaled size is dropped
+    unsigned validRows = jpeg.height;
+    if (!jpeg.complete) {
+        unsigned margin = 16;
+        validRows = jpeg.error.truncatedRow > margin ? jpeg.error.truncatedRow - margin : 0;
+    }
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+    for (unsigned y = 0; y < jpeg.height; ++y) {
+        auto row = store->pixelsStartingAt(0, y);
+        if (y >= validRows) {
+            for (unsigned x = 0; x < jpeg.width; ++x)
+                store->setPixel(row[x], 0xFF, 0xFF, 0xFF, 0xFF);
+            continue;
+        }
+        const JSAMPLE* source = jpeg.rows[y];
+#if defined(TURBO_JPEG_RGB_SWIZZLE)
+        if (turboSwizzled(jpeg.info.out_color_space)) {
+            memcpy(row.data(), source, jpeg.width * sizeof(uint32_t));
+            continue;
+        }
+#endif
+        for (unsigned x = 0; x < jpeg.width; ++x) {
+            if (jpeg.info.out_color_space == JCS_CMYK) {
+                // inverted CMYK to RGB, the same arithmetic as the incremental decoder
+                unsigned k = source[x * 4 + 3];
+                store->setPixel(row[x], source[x * 4] * k / 255, source[x * 4 + 1] * k / 255, source[x * 4 + 2] * k / 255, 0xFF);
+            } else
+                store->setPixel(row[x], source[x * 3], source[x * 3 + 1], source[x * 3 + 2], 0xFF);
+        }
+    }
+    WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+    // the frame buffer cache stays empty here, so completeness is reported from this flag
+    m_scaledFrameDecoded = jpeg.complete && isAllDataReceived();
+    return store->image();
+}
+
+bool JPEGImageDecoder::frameIsCompleteAtIndex(size_t index) const
+{
+    if (ScalableImageDecoder::frameIsCompleteAtIndex(index))
+        return true;
+    Locker locker { m_lock };
+    return !index && m_scaledFrameDecoded;
+}
+
+bool JPEGImageDecoder::frameHasAlphaAtIndex(size_t index) const
+{
+    {
+        Locker locker { m_lock };
+        // a decoded jpeg is opaque
+        if (!index && m_scaledFrameDecoded)
+            return false;
+    }
+    return ScalableImageDecoder::frameHasAlphaAtIndex(index);
+}
